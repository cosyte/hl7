{
  "name": "@cosyte/hl7",
  "version": "0.1.8",
  "description": "Developer-focused HL7 v2 toolkit for Node.js and TypeScript, message parsing and building, mutation and serialization, and one-line helpers.",
  "keywords": [
    "hl7",
    "hl7v2",
    "hl7-v2",
    "parser",
    "builder",
    "serializer",
    "healthcare",
    "interoperability",
    "typescript",
    "adt",
    "oru",
    "mllp",
    "toolkit"
  ],
  "homepage": "https://docs.cosyte.com/hl7",
  "bugs": {
    "url": "https://github.com/cosyte/hl7/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosyte/hl7.git"
  },
  "license": "MIT",
  "author": "Cosyte <hello@cosyte.com> (https://cosyte.com)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "esbuild@>=0.27.3 <0.28.2": "0.28.2",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "minimatch@>=7.0.0 <11.0.1": "11.0.1"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./arbitraries": {
      "import": {
        "types": "./dist/arbitraries.d.ts",
        "default": "./dist/arbitraries.mjs"
      },
      "require": {
        "types": "./dist/arbitraries.d.cts",
        "default": "./dist/arbitraries.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "arbitraries": [
        "./dist/arbitraries.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "TRADEMARKS.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@cosyte/prettier-config",
  "scripts": {
    "build": "cosyte-process build",
    "changeset": "changeset",
    "typecheck": "cosyte-process typecheck",
    "phi-scan": "tsx scripts/phi-scan.ts",
    "generate:structures": "tsx scripts/generate-message-structures.ts",
    "generate:schema": "tsx scripts/generate-schema-artifacts.ts",
    "bench": "tsx scripts/bench.ts",
    "bench:reading": "cosyte-bench run --suite bench/parse.bench.mjs --target dist/index.mjs",
    "bench:compare": "cosyte-bench compare --suite bench/parse.bench.mjs",
    "lint": "cosyte-process lint",
    "lint:fix": "cosyte-process lint --fix",
    "format": "cosyte-process format",
    "format:check": "cosyte-process format --check",
    "check:docs": "tsx scripts/check-docs.ts",
    "check:no-emdash": "cosyte-no-emdash",
    "check:no-internal-refs": "cosyte-internal-refs",
    "check:readme": "cosyte-readme",
    "check:claude-card": "cosyte-claude-card",
    "check:catalog": "cosyte-catalog",
    "check:documents": "pnpm check:readme && pnpm check:claude-card && pnpm check:catalog",
    "check:process": "cosyte-process check",
    "test": "cosyte-process test",
    "test:watch": "cosyte-process test --watch",
    "test:coverage": "cosyte-process test --coverage",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "quality:check": "cosyte-ratchet check --skip mutation",
    "quality:mutation": "cosyte-ratchet check --skip coverage",
    "quality:raise": "cosyte-ratchet raise",
    "mutate": "cosyte-mutate",
    "clean": "rm -rf dist coverage",
    "examples": "tsx scripts/run-examples.ts",
    "pack:docs": "cosyte-process pack-docs",
    "attw": "cosyte-attw",
    "version": "changeset version && cosyte-process sync-version && prettier --write package.json src/index.ts",
    "release": "changeset publish",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm attw",
    "prepare": "command -v simple-git-hooks >/dev/null 2>&1 && simple-git-hooks 1>&2 || true"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm phi-scan --staged"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.31.0",
    "@cosyte/bench": "^0.1.1",
    "@cosyte/eslint-config": "^0.1.4",
    "@cosyte/prettier-config": "^0.1",
    "@cosyte/process": "^0.1.7",
    "@cosyte/script-utils": "0.1.9",
    "@cosyte/test-utils": "^0.1.4",
    "@cosyte/tsconfig": "^0.1",
    "@cosyte/tsup-config": "^0.1.3",
    "@cosyte/vitest-config": "^0.1.4",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "^22.0.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "simple-git-hooks": "2.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "fast-check": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "fast-check": {
      "optional": true
    }
  },
  "dependencies": {}
}
