{
  "name": "@{{YOUR_ORG}}/hl7-profile-{{PROFILE_NAME}}",
  "version": "0.1.0",
  "description": "HL7 profile package for {{YOUR_ORG}} integrations, built with @cosyte/hl7.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CUSTOMIZING.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "prettier": "@cosyte/prettier-config",
  "scripts": {
    "build": "cosyte-process build",
    "typecheck": "cosyte-process typecheck",
    "lint": "cosyte-process lint",
    "lint:fix": "cosyte-process lint --fix",
    "format": "cosyte-process format",
    "format:check": "cosyte-process format --check",
    "test": "cosyte-process test",
    "test:watch": "cosyte-process test --watch",
    "attw": "cosyte-attw",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm attw"
  },
  "peerDependencies": {
    "@cosyte/hl7": ">=0.0.0"
  },
  "peerDependenciesMeta": {
    "@cosyte/hl7": {
      "optional": false
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@cosyte/eslint-config": "^0.1.4",
    "@cosyte/hl7": "file:../..",
    "@cosyte/prettier-config": "^0.1",
    "@cosyte/process": "^0.1.7",
    "@cosyte/script-utils": "0.1.14",
    "@cosyte/tsconfig": "^0.1",
    "@cosyte/tsup-config": "^0.1.3",
    "@cosyte/vitest-config": "^0.1.3",
    "@types/node": "^22.0.0",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
